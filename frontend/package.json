{
  "name": "ldes-admin-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Frontend of LDES-admin: monitor and manage OpenLDES servers and LDIO pipelines",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build-restrict-to-demo-mode": "vue-tsc --build && vite build --mode demo-only",
    "preview": "vite preview --port 4173 --strictPort",
    "type-check": "vue-tsc --build",
    "test": "jest",
    "test:e2e": "vite build && start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:open": "start-server-and-test dev http://localhost:5173 'cypress open --e2e'"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@primeuix/themes": "^2.0.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "chart.js": "^4.6.1",
    "codemirror": "^6.0.2",
    "n3": "^1.26.0",
    "pinia": "^4.1.0",
    "primeicons": "^8.0.2",
    "primevue": "^4.5.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@tsconfig/node22": "^22.0.6",
    "@types/jest": "^29.5.14",
    "@types/n3": "^1.26.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "cypress": "16.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "start-server-and-test": "^3.0.13",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
