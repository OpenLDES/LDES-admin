<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>org.openldes</groupId>
  <artifactId>ldes-admin</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>LDES-admin</name>
  <description>
    Administration, monitoring and sandboxing tool for OpenLDES servers and LDIO pipelines
  </description>
  <url/>
  <licenses>
    <license/>
  </licenses>
  <developers>
    <developer/>
  </developers>
  <scm>
    <connection/>
    <developerConnection/>
    <tag/>
    <url/>
  </scm>

  <!--
    Hexagonal architecture: every ring is a separate Maven module, so the dependency rule
    (adapter -> application -> model) is enforced by the compiler. The frontend is built into a
    jar of static resources that the bootstrap module serves.
    See analysis/architecture.md.
  -->
  <modules>
    <module>model</module>
    <module>application</module>
    <module>adapter</module>
    <module>frontend</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <jena.version>6.2.0</jena.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- Only the bootstrap module contains a runnable application -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
    <!-- Extended by modules that load Mockito as a Java agent -->
    <argLine/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-frontend</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-arq</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Modules using Mockito activate the 'properties' goal and add
          -javaagent:${org.mockito:mockito-core:jar} to argLine, as newer JDKs no longer allow
          Mockito to attach itself.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <executions>
            <execution>
              <id>dependency-properties</id>
              <goals>
                <goal>properties</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
