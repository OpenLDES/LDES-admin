<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>org.openldes</groupId>
  <artifactId>ldes-admin</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>LDES-admin</name>
  <description>
    Administration, monitoring and sandboxing tool for OpenLDES servers and LDIO pipelines
  </description>
  <url/>
  <licenses>
    <license/>
  </licenses>
  <developers>
    <developer/>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/OpenLDES/LDES-admin.git</connection>
    <developerConnection>scm:git:git@github.com:OpenLDES/LDES-admin.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/OpenLDES/LDES-admin/tree/main</url>
  </scm>

  <!--
    Hexagonal architecture: every ring is a separate Maven module, so the dependency rule
    (adapter -> application -> model) is enforced by the compiler. The frontend is built into a
    jar of static resources that the bootstrap module serves.
    See _analysis/architecture.md.
  -->
  <modules>
    <module>model</module>
    <module>application</module>
    <module>adapter</module>
    <module>frontend</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <jena.version>6.2.0</jena.version>
    <!--
      The LDI components the sandbox runs (adapter.out.sandbox): the same code as the LDIO image
      of local instances. LDI is built on Jena 5; Jena is aligned to the version of LDES-admin.
      (BOMs of Jena and rdf4j are not imported: they manage Spring 5.)
    -->
    <ldi.version>3.1.1</ldi.version>
    <commons-text.version>1.15.0</commons-text.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- Only the bootstrap module contains a runnable application -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
    <!-- Extended by modules that load Mockito as a Java agent, and by JaCoCo (profile coverage) -->
    <argLine/>
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- SonarCloud analysis in the GitHub workflows, with the coverage of the coverage profile -->
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes</groupId>
        <artifactId>ldes-admin-frontend</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!--
        One by one: jena-bom imports what its parent manages for Fuseki too (Shiro, Spring 5,
        Hibernate 5)
      -->
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-arq</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-core</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-base</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-geosparql</artifactId>
        <version>${jena.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-text</artifactId>
        <version>${commons-text.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>ldi-common</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>rdf-adapter</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>json-to-ld-adapter</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>rml-adapter</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>ngsiv2-to-ld-adapter</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>sparql-construct</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>version-object-creator</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>version-materialiser</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>geojson-to-wkt</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>skolemisation-transformer</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>change-detection-filter</artifactId>
        <version>${ldi.version}</version>
        <exclusions>
          <!-- Hibernate 5 for its SQL state; the sandbox keeps the state in memory -->
          <exclusion>
            <groupId>org.openldes.ldi</groupId>
            <artifactId>ldi-infra-sql</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>request-executor</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>http-sparql-out</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openldes.ldi</groupId>
        <artifactId>repository-sink</artifactId>
        <version>${ldi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Modules using Mockito activate the 'properties' goal and add
          -javaagent:${org.mockito:mockito-core:jar} to argLine, as newer JDKs no longer allow
          Mockito to attach itself.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <executions>
            <execution>
              <id>dependency-properties</id>
              <goals>
                <goal>properties</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- Workflow 4 (Prepare New Version) tags the release and moves on to the next snapshot -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>${maven-release-plugin.version}</version>
          <configuration>
            <scmCommentPrefix>[ci skip]</scmCommentPrefix>
            <tagNameFormat>@{project.version}</tagNameFormat>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Test coverage for SonarCloud: ./mvnw verify -Pcoverage -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <formats>
                    <format>XML</format>
                  </formats>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
