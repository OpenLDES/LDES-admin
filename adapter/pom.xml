<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.openldes</groupId>
    <artifactId>ldes-admin</artifactId>
    <version>0.0.1</version>
  </parent>
  <artifactId>ldes-admin-adapter</artifactId>
  <name>LDES-admin :: Adapter</name>
  <description>
    Inbound adapters (REST API) and outbound adapters (Postgres/JPA, LDES server, LDIO, Docker)
  </description>

  <dependencies>
    <dependency>
      <groupId>org.openldes</groupId>
      <artifactId>ldes-admin-application</artifactId>
    </dependency>

    <!-- Inbound: REST API -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Outbound: persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Outbound: LDES server and LDIO admin APIs -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
    </dependency>

    <!-- Outbound: local (sandbox) LDES servers and LDIOs, started as Docker containers -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
    </dependency>

    <!-- Outbound: the sandbox runtime, which runs the LDI components of LDIO pipelines -->
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>ldi-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>rdf-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>json-to-ld-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>rml-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>ngsiv2-to-ld-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>sparql-construct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>version-object-creator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>version-materialiser</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>geojson-to-wkt</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>skolemisation-transformer</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>change-detection-filter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>request-executor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>http-sparql-out</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openldes.ldi</groupId>
      <artifactId>repository-sink</artifactId>
    </dependency>
    <!-- Unescapes the body of HTTP enricher requests, as LDIO does -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
